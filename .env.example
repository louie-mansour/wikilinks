# PostHog analytics (backend). Loaded by the Makefile via -include .env.
# Copy this file to .env and fill in the values.
POSTHOG_API_KEY=
# Analytics environment tag on server events (default: local). Set to "production" in prod.
APP_ENV=local

# Production VPS IP (used by make server-setup and make upload-data)
VPS_IP=195.201.98.114